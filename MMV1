            return cachedLevel
        end
    end
    return cachedLevel
end

local cachedCoinsLabel = nil

-- Get Player's Actual Total Coins balance (from leaderstats/PlayerData or UI scanning)
local function getPlayerCoins()
    if cachedCoinsLabel and cachedCoinsLabel.Parent then
        local cleanText = string.gsub(cachedCoinsLabel.Text, ",", "")
        local num = tonumber(string.match(cleanText, "%d+"))
        if num then return num end
    end

    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if playerGui then
        -- 1. Try Shop ScreenGui desktop paths first
        local shop = playerGui:FindFirstChild("Shop")
        if shop then
            local desktop = shop:FindFirstChild("ShopDesktop")
            local main = desktop and desktop:FindFirstChild("Main")
            if main then
                for _, descendant in ipairs(main:GetDescendants()) do
                    if descendant:IsA("TextLabel") then
                        local name = string.lower(descendant.Name)
                        local parent = descendant.Parent
                        local parentName = parent and string.lower(parent.Name) or ""
                        if (name == "amount" or name == "text" or string.find(name, "coin")) and 
                           (string.find(parentName, "coin") or string.find(parentName, "currency")) and 
                           not string.find(parentName, "bag") then
                            local cleanText = string.gsub(descendant.Text, ",", "")
                            local num = tonumber(string.match(cleanText, "^%d+$"))
                            if num then
                                cachedCoinsLabel = descendant
                                return num
                            end
                        end
                    end
                end
            end
        end

        -- 2. Try MainGUI Lobby Topbar path
        local mainGui = playerGui:FindFirstChild("MainGUI")
        if mainGui then
            local lobby = mainGui:FindFirstChild("Lobby")
            local lobbyMain = lobby and lobby:FindFirstChild("Main")
            local topBar = lobbyMain and lobbyMain:FindFirstChild("TopBar")
            local coinsFrame = topBar and (topBar:FindFirstChild("Coins") or topBar:FindFirstChild("Coin"))
            local amountLabel = coinsFrame and (coinsFrame:FindFirstChild("Amount") or coinsFrame:FindFirstChild("Text"))
            if amountLabel and amountLabel:IsA("TextLabel") then
                local cleanText = string.gsub(amountLabel.Text, ",", "")
                local num = tonumber(string.match(cleanText, "%d+"))
                if num then
                    cachedCoinsLabel = amountLabel
                    return num
                end
            end
        end

        -- 3. General fallback search in PlayerGui (excluding CoinBag and labels containing "/")
        for _, descendant in ipairs(playerGui:GetDescendants()) do
            if descendant:IsA("TextLabel") and descendant.Visible then
                local name = string.lower(descendant.Name)
                local parent = descendant.Parent
                local parentName = parent and string.lower(parent.Name) or ""
                if (string.find(name, "coin") or string.find(name, "gold") or string.find(parentName, "coin") or string.find(parentName, "gold")) and
                   not string.find(name, "bag") and not string.find(parentName, "bag") and not string.find(descendant.Text, "/") then
                    local cleanText = string.gsub(descendant.Text, ",", "")
                    local num = tonumber(string.match(cleanText, "^%d+$"))
                    if num then
                        cachedCoinsLabel = descendant
                        return num
                    end
                end
            end
        end
    end

    -- Fallback search in LocalPlayer ValueObjects
    local pd = LocalPlayer:FindFirstChild("PlayerData")
    if pd then
        local coins = pd:FindFirstChild("Coins") or pd:FindFirstChild("Gold") or pd:FindFirstChild("Coin")
        if coins and coins:IsA("ValueObject") then return coins.Value end
    end
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        local coins = leaderstats:FindFirstChild("Coins")
        if coins then return coins.Value end
    end

    return _G.Hub67Settings.CoinsCollected
end

-- Check if player is waiting in lobby or spectating
local function isWaitingForTurn()
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if playerGui then
        local mainGui = playerGui:FindFirstChild("MainGUI")
        if mainGui then
            -- 1. Try fast path inside Game status elements
            local gameFrame = mainGui:FindFirstChild("Game")
            if gameFrame then
                for _, label in ipairs(gameFrame:GetDescendants()) do
                    if label:IsA("TextLabel") and label.Visible then
                        local text = string.lower(label.Text)
                        if string.find(text, "waiting for your turn") or string.find(text, "spectating") or string.find(text, "waiting...") then
                            return true
                        end
                    end
                end
            end
            
            -- 2. General scan in MainGUI for any waiting/spectating texts
            for _, label in ipairs(mainGui:GetDescendants()) do
                if label:IsA("TextLabel") and label.Visible then
                    local text = string.lower(label.Text)
                    if string.find(text, "waiting for your turn") or string.find(text, "spectating") then
                        return true
                    end
                end
            end
        end
    end
    return false
end

-- Scan screen for dynamic Bag counter (Cached)
local function getBagStatus()
    if cachedBagLabel and cachedBagLabel.Parent then
        return cachedBagLabel.Text
    end

    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if playerGui then
        -- Search fast path first
        local mainGui = playerGui:FindFirstChild("MainGUI")
        if mainGui then
            local gameFrame = mainGui:FindFirstChild("Game")
            local coinBag = gameFrame and (gameFrame:FindFirstChild("CoinBag") or gameFrame:FindFirstChild("CashBag"))
            if coinBag and coinBag:IsA("TextLabel") then
                cachedBagLabel = coinBag
                return coinBag.Text
            end
            
            -- Fallback recursive scan inside MainGUI only
            for _, label in ipairs(mainGui:GetDescendants()) do
                if label:IsA("TextLabel") and label.Visible then
                    local text = label.Text
                    if string.match(text, "%d+/%d+") then
                        local name = string.lower(label.Name)
                        if string.find(name, "bag") or string.find(name, "coin") then
                            cachedBagLabel = label
                            return text
                        end
                    end
                end
            end
        end
    end
    
    -- Fallback calculation checking if player has Elite
    local maxBag = 10
    local pd = LocalPlayer:FindFirstChild("PlayerData")
    if pd then
        local elite = pd:FindFirstChild("Elite")
        if elite and elite.Value == true then
            maxBag = 50
        end
    end
    if LocalPlayer:FindFirstChild("Elite") then
        maxBag = 50
    end
    
    local current = math.min(maxBag, _G.Hub67Settings.CoinsCollected % (maxBag + 1))
    return tostring(current) .. "/" .. tostring(maxBag)
end

-- Get all available coins from cached CoinContainer
local function getCoins()
    local coins = {}
    local container = getCoinContainer()
    if container then
        local children = container:GetChildren()
        for i = 1, #children do
            local child = children[i]
            if child:IsA("BasePart") or child:IsA("Model") then
                table.insert(coins, child)
            end
        end
    end
    return coins
end

