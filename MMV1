local function getCoinBagValue()
	local playerGui = player:FindFirstChild("PlayerGui")
	local mainGui = playerGui and playerGui:FindFirstChild("MainGUI")
	local gameGui = mainGui and mainGui:FindFirstChild("Game")
	local coinBags = gameGui and (gameGui:FindFirstChild("CoinBags") or gameGui:FindFirstChild("CoinBag") or gameGui:FindFirstChild("Coins"))
	
	if coinBags then
		local container = coinBags:FindFirstChild("Container")
		local coin = container and container:FindFirstChild("Coin")
		local currencyFrame = coin and coin:FindFirstChild("CurrencyFrame")
		local icon = currencyFrame and currencyFrame:FindFirstChild("Icon")
		local coins = icon and icon:FindFirstChild("Coins")

		if coins then
			local ok, text = pcall(function()
				return coins.Text
			end)
			if ok and tonumber(text) then
				return tonumber(text)
			end
		end

		-- Fallback recursive scan inside coinBags
		for _, desc in ipairs(coinBags:GetDescendants()) do
			if desc:IsA("TextLabel") and desc.Text ~= "" and not desc.Text:find("/") then
				local val = tonumber(string.gsub(desc.Text, "[^%d]", ""))
				if val then
					return val
				end
			end
		end
	end

	-- General fallback scan
	if mainGui then
		for _, desc in ipairs(mainGui:GetDescendants()) do
			if desc:IsA("TextLabel") and desc.Visible and desc.Text ~= "" then
				local txt = desc.Text
				if txt:find("Full") or txt:find("FULL") then
					return getFullBagValue()
				end
			end
		end
	end

	return 0
end

local function isCoinBagFull()
	return getCoinBagValue() >= getFullBagValue()
end

local function waitForEmptyCoinBag()
