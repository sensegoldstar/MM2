-- Find nearest coin from cached coins list (O(C + P) complexity - cached player search)
local function getNearestCoin()
    local character = LocalPlayer.Character
    if not character then return nil end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end

    local coins = getCoins()
    local nearest = nil
    local minDistance = math.huge

    -- Cache rival positions to optimize O(C*P) search down to O(C+P)
    local rivalPositions = {}
    local playersList = Players:GetPlayers()
    for i = 1, #playersList do
        local p = playersList[i]
        if p ~= LocalPlayer and p.Character then
            local er = p.Character:FindFirstChild("HumanoidRootPart")
            if er then
                table.insert(rivalPositions, er.Position)
            end
        end
    end

    local function isRivalNear(coinPos)
        for j = 1, #rivalPositions do
            if (rivalPositions[j] - coinPos).Magnitude < 4.0 then
                return true
            end
        end
        return false
    end

    -- Attempt 1: Target nearest coin that rival players are NOT currently on top of
    for i = 1, #coins do
        local coin = coins[i]
        local pos = getCoinPosition(coin)
        if pos and not isRivalNear(pos) then
            local dist = (pos - rootPart.Position).Magnitude
            if dist < minDistance then
                minDistance = dist
                nearest = coin
            end
        end
    end

    -- Attempt 2: Fallback to absolute nearest coin if all coins have players nearby
    if not nearest then
        for i = 1, #coins do
            local coin = coins[i]
            local pos = getCoinPosition(coin)
            if pos then
                local dist = (pos - rootPart.Position).Magnitude
                if dist < minDistance then
                    minDistance = dist
                    nearest = coin
                end
            end
        end
    end

    return nearest
end

-- Fire TouchInterest connections to trigger server detection early
local function triggerTouchInterest(rootPart, targetCoin)
    local touchPart = nil
    if targetCoin:IsA("BasePart") then
        touchPart = targetCoin
    elseif targetCoin:IsA("Model") then
        touchPart = targetCoin.PrimaryPart or targetCoin:FindFirstChildWhichIsA("BasePart")
    end

    if touchPart and firetouchinterest then
        task.spawn(function()
            firetouchinterest(rootPart, touchPart, 0)
            task.wait()
            firetouchinterest(rootPart, touchPart, 1)
        end)
    end
end

local isTweening = false

-- Smooth character tweening using TweenService for reliable collision and touch interest firing
local function tweenTo(targetCoin)
    local character = LocalPlayer.Character
    if not character then return false end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end

    local targetPosition = getCoinPosition(targetCoin)
    if not targetPosition then return false end

    local distance = (targetPosition - rootPart.Position).Magnitude
    local duration = distance / _G.Hub67Settings.Speed

    if TaskLabel then
        TaskLabel.Text = string.format("Task: Tweening to Coin (Dist: %.1f)", distance)
    end

    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = CFrame.new(targetPosition)})

    isTweening = true
    local completed = false
    local connection
    connection = tween.Completed:Connect(function()
        completed = true
        if connection then connection:Disconnect() end
    end)

    tween:Play()

    while not completed and _G.Hub67Settings.Enabled and targetCoin and targetCoin.Parent do
        task.wait()
        
        -- Safe abort if character states change
        if not LocalPlayer.Character or not rootPart.Parent or not humanoid.Parent or humanoid.Health <= 0 then
            tween:Cancel()
            if connection then connection:Disconnect() end
            isTweening = false
            return false
        end

        -- Early claim using TouchInterest within 8 studs
        local curDist = (targetPosition - rootPart.Position).Magnitude
        if curDist < 8.0 then
            triggerTouchInterest(rootPart, targetCoin)
        end
    end

    isTweening = false

    if not _G.Hub67Settings.Enabled then
        tween:Cancel()
        if connection then connection:Disconnect() end
        return false
    end

    if connection then
        connection:Disconnect()
    end
    
    -- Reset velocity and force to prevent residual inertia/flings
    if rootPart and rootPart.Parent then
        rootPart.Velocity = Vector3.new(0, 0, 0)
        rootPart.RotVelocity = Vector3.new(0, 0, 0)
    end
    
    return true
end

-- Stepped connection for Noclip (Active ONLY while moving to prevent falling through floor when idle)
local noclipConnection = nil
local function startNoclipLoop()
    if noclipConnection then return end
    noclipConnection = RunService.Stepped:Connect(function()
        if not _G.Hub67Running then
            if noclipConnection then
                noclipConnection:Disconnect()
                noclipConnection = nil
            end
            return
        end
        
        if _G.Hub67Settings.Enabled and _G.Hub67Settings.Noclip and isTweening then
            local parts = getCharacterParts()
            for i = 1, #parts do
                local part = parts[i]
                if part.Parent and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
    end)
end

