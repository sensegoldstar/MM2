-- Server Hop Function
local function serverHop()
    local TeleportService = game:GetService("TeleportService")
    local placeId = game.PlaceId
    local currentJobId = game.JobId
    
    local servers = {}
    pcall(function()
        local raw = nil
        local reqFunc = (syn and syn.request) or (http and http.request) or http_request or request
        if reqFunc then
            local res = reqFunc({
                Url = string.format("https://games.roblox.com/v1/games/%d/servers/0?sortOrder=Desc&limit=100", placeId),
                Method = "GET"
            })
            if res and res.Body then raw = res.Body end
        elseif game.HttpGet then
            raw = game:HttpGet(string.format("https://games.roblox.com/v1/games/%d/servers/0?sortOrder=Desc&limit=100", placeId))
        end

        if raw then
            local decoded = HttpService:JSONDecode(raw)
            if decoded and decoded.data then
                for _, s in ipairs(decoded.data) do
                    if type(s) == "table" and s.id ~= currentJobId and s.playing and s.maxPlayers and s.playing < s.maxPlayers then
                        table.insert(servers, s.id)
                    end
                end
            end
        end
    end)

    if #servers > 0 then
        local targetJobId = servers[math.random(1, #servers)]
        TeleportService:TeleportToPlaceInstance(placeId, targetJobId, player)
    else
        pcall(function()
            TeleportService:Teleport(placeId, player)
        end)
    end
end

