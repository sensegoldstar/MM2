-- UI Update Thread
task.spawn(function()
    local startTime = os.time()
    while task.wait(1) do
        pcall(function()
            local elapsed = os.time() - startTime
            local hrs = math.floor(elapsed / 3600)
            local mins = math.floor((elapsed % 3600) / 60)
            local secs = elapsed % 60
            TimeLabel.Text = string.format("⏱️ Time: %02d:%02d:%02d", hrs, mins, secs)
            
            local activeMap = "Lobby"
            local container = getCoinContainers()[1]
            if container and container.Parent and container.Parent.Name ~= "Lobby" then
                activeMap = container.Parent.Name
            end
            MapLabel.Text = "🗺️ Map: " .. activeMap
            
            local bagVal = getCoinBagValue()
            local targetVal = getFullBagValue()
            CoinLabel.Text = string.format("🟡 Coin: %d/%d", bagVal, targetVal)
            
            local currentTarget = {}
            local weaponsContainer = getWeaponsContainer()
            if weaponsContainer then
                local counts = {}
                for _, item in pairs(weaponsContainer:GetChildren()) do
                    if item.Name == "NewItem" then
                        local label = item:FindFirstChild("ItemName") and item.ItemName:FindFirstChild("Label")
                        if label and label:IsA("TextLabel") then
                            local name = label.Text
                            if allowed[name] then
                                counts[name] = (counts[name] or 0) + 1
                            end
                        end
                    end
                end
                for name, count in pairs(counts) do
                    table.insert(currentTarget, name .. ": " .. tostring(count))
                end
            end
            local itemsStr = #currentTarget > 0 and table.concat(currentTarget, " | ") or "None"
            ItemsLabel.Text = "🗡️ Target Items: " .. itemsStr
            
            local farmStatus = isAutoFarmEnabled() and "Active" or "Disabled"
            StatusLabel.Text = "⚡ Autofarm: " .. farmStatus
            
            local weapons = {}
            if weaponsContainer then
                for _, item in pairs(weaponsContainer:GetChildren()) do
                    if item.Name == "NewItem" then
                        local label = item:FindFirstChild("ItemName") and item.ItemName:FindFirstChild("Label")
                        if label and label:IsA("TextLabel") then
                            local name = label.Text
                            if allowed[name] then
                                table.insert(weapons, name)
                            end
                        end
                    end
                end
            end
            table.sort(weapons)
            local weaponsStr = (#weapons > 0) and table.concat(weapons, " : ") or "None"
            weaponsStr = weaponsStr:gsub("[|;]", "")
            HorstLabel.Text = "💰 Horst State: 💰 " .. coinsText .. " : " .. weaponsStr
        end)
    end
end)

-- Main Farming loop
while task.wait(SCAN_DELAY) do
	if not character or not humanoid or not hrp or not hrp.Parent then
		continue
	end

	if isAutoFarmEnabled() then
		if isCoinBagFull() then
			handleFullCoinBag()
			continue
		end

		local coin = getNearestCoin()
		if coin then
			tweenUntilCoinGone(coin)
		end
	end
end
