-- Premium Discord Webhook Notifier
local function sendDiscordNotification(itemName)
    local config = getgenv().VCPP_Config
    local url = config and config.WebhookURL
    if not url or url == "" or url:find("webhooks/...") then return end
    
    local pingText = (config.DiscordID and config.DiscordID ~= "") and ("<@" .. config.DiscordID .. ">") or nil
    local embed = {
        title = "🎉 [Horst MM2] ได้รับไอเทมเป้าหมายใหม่สำเร็จ!",
        color = 16711680, -- Godly Red/Gold Accent
        description = "พบอาวุธเป้าหมายจำกัดสุ่มสำเร็จ!",
        fields = {
            { name = "👤 Player", value = player.Name, inline = true },
            { name = "🗡️ อาวุธ", value = itemName, inline = true },
            { name = "💰 จำนวนเหรียญใน Shop", value = coinsText or "0", inline = true },
        },
        footer = { text = "Horst MM2 Webhook Assistant" },
        timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
    }
    
    local payload = {
        content = pingText,
        embeds = { embed }
    }
    
    local reqFunc = (syn and syn.request) or (http and http.request) or http_request or request
    if reqFunc then
        pcall(function()
            reqFunc({
                Url = url,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode(payload)
            })
        end)
    end
end

-- Horst inventory & Coins desc reporter
local function updateHorstDescription()
	local weapons = {}
	local jsonData = {}

	local container = getWeaponsContainer()
	if container then
		for _, item in pairs(container:GetChildren()) do
			if item.Name == "NewItem" then
				local label = item:FindFirstChild("ItemName") and item.ItemName:FindFirstChild("Label")

				if label and label:IsA("TextLabel") then
					local name = label.Text

					if allowed[name] then
						table.insert(weapons, name)
						jsonData[name] = (jsonData[name] or 0) + 1
						
						-- Webhook notification trigger
						if not notifiedWeapons[item] then
							notifiedWeapons[item] = true
							task.spawn(function()
								sendDiscordNotification(name)
							end)
						end
					end
				end
			end
		end
	end

	table.sort(weapons)

	local weaponsStr = (#weapons > 0) and table.concat(weapons, " : ") or "None"
	weaponsStr = weaponsStr:gsub("[|;]", "")

	coinsText = "0"
	local shopGui = player:FindFirstChild("PlayerGui") and player.PlayerGui:FindFirstChild("CrossPlatform")
	if shopGui then
		local coinsAmount = shopGui:FindFirstChild("Shop", true) and shopGui.Shop:FindFirstChild("Medium") and shopGui.Shop.Medium:FindFirstChild("Title") and shopGui.Shop.Medium.Title:FindFirstChild("Coins") and shopGui.Shop.Medium.Title.Coins:FindFirstChild("Container") and shopGui.Shop.Medium.Title.Coins.Container:FindFirstChild("Amount")
		
		if coinsAmount and coinsAmount:IsA("TextLabel") then
			coinsText = coinsAmount.Text
			jsonData["Coins"] = coinsText
		end
	end

	local message = "💰 " .. coinsText .. " : " .. weaponsStr
	local encodeJson = HttpService:JSONEncode(jsonData)

	if _G and _G.Horst_SetDescription then
		_G.Horst_SetDescription(message, encodeJson)
		print("[Horst] " .. message)
	else
		warn("_G.Horst_SetDescription not found.")
	end
end

task.spawn(function()
	while true do
		pcall(updateHorstDescription)
		task.wait(10)
	end
end)

