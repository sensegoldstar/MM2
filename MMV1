-- Character parts caching for Noclip
local cachedCharacterParts = {}
local lastCharacter = nil

local function getCharacterParts()
    local char = LocalPlayer.Character
    if not char then
        cachedCharacterParts = {}
        lastCharacter = nil
        return cachedCharacterParts
    end
    
    if char == lastCharacter then
        return cachedCharacterParts
    end
    
    lastCharacter = char
    cachedCharacterParts = {}
    
    -- Cache current parts
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            table.insert(cachedCharacterParts, part)
        end
    end
    
    -- Dynamic update if parts are added later
    local connection
    connection = char.DescendantAdded:Connect(function(descendant)
        if not lastCharacter or lastCharacter ~= char then
            connection:Disconnect()
            return
        end
        if descendant:IsA("BasePart") then
            table.insert(cachedCharacterParts, descendant)
        end
    end)
    
    return cachedCharacterParts
end

-- Console log function
local maxLogs = 50
local logsList = {}

local function logMessage(text)
    local timeStr = os.date("%H:%M:%S")
    local formattedText = string.format("[%s] %s", timeStr, text)
    print("[67 HUB Console] " .. text)
    
    if not LogScroll then return end
    
    -- Create text label
    local logLabel = Instance.new("TextLabel")
    logLabel.Size = UDim2.new(1, -10, 0, 18)
    logLabel.BackgroundTransparency = 1
    logLabel.Text = formattedText
    logLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
    logLabel.Font = Enum.Font.Code
    logLabel.TextSize = 11
    logLabel.TextXAlignment = Enum.TextXAlignment.Left
    logLabel.Parent = LogScroll
    
    table.insert(logsList, logLabel)
    if #logsList > maxLogs then
        local oldest = table.remove(logsList, 1)
        oldest:Destroy()
    end
    
    LogScroll.CanvasSize = UDim2.new(0, 0, 0, #logsList * 18)
    LogScroll.CanvasPosition = Vector2.new(0, math.max(0, (#logsList * 18) - LogScroll.AbsoluteWindowSize.Y))
end

-- Scan the Elite perks board in the Lobby (New Request)
local function checkEliteCoinBagPath()
    local path = workspace:FindFirstChild("Lobby")
    path = path and path:FindFirstChild("Elite")
    path = path and path:FindFirstChild("Display")
    path = path and path:FindFirstChild("SurfaceGui")
    path = path and path:FindFirstChild("Frame")
    path = path and path:FindFirstChild("List")
    path = path and path:FindFirstChild("CoinBag")
    
    if path then
        local classType = path.ClassName
        local contentInfo = ""
        if path:IsA("TextLabel") or path:IsA("TextButton") then
            contentInfo = "Text: " .. tostring(path.Text)
        elseif path:IsA("ValueObject") or pcall(function() return path.Value end) then
            contentInfo = "Value: " .. tostring(path.Value)
        else
            contentInfo = "Class: " .. classType
        end
        logMessage("Elite CoinBag Path Found! " .. contentInfo)
        return path
    else
        logMessage("Elite CoinBag Path NOT Found in workspace.Lobby!")
        return nil
    end
end

-- Get or search the CoinContainer folder dynamically (Cached)
local function getCoinContainer()
    if cachedContainer and cachedContainer.Parent then
        return cachedContainer
    end
    
    -- Scan workspace children (fast check)
    for _, item in ipairs(workspace:GetChildren()) do
        if item:IsA("Model") or item:IsA("Folder") then
            local container = item:FindFirstChild("CoinContainer")
            if container then
                cachedContainer = container
                logMessage("ตรวจพบแหล่งเหรียญใหม่: " .. tostring(item.Name))
                return container
            end
        end
    end
    
    -- Fallback: deep search
    local container = workspace:FindFirstChild("CoinContainer", true)
    if container then
        cachedContainer = container
        if container.Parent then
            logMessage("ตรวจพบแหล่งเหรียญใหม่ (Deep): " .. tostring(container.Parent.Name))
        end
        return container
    end
    
    return nil
end

-- Detect map name dynamically
local function getActiveMapName()
    local container = getCoinContainer()
    if container and container.Parent then
        return container.Parent.Name
    end
    return "Lobby"
end

-- Get level from Murder Mystery 2 structure (Rate-Limited)
local function getPlayerLevel()
    if os.time() - lastLevelCheck < 5 then
        return cachedLevel
    end
    lastLevelCheck = os.time()
    
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        local lvl = leaderstats:FindFirstChild("Level") or leaderstats:FindFirstChild("Rank")
