local function canSelectCoin(coin)
	if not coin
		or not coin.Parent
		or not coin:IsA("BasePart")
		or coin.Name ~= "Coin_Server" then
		return false
	end

	if not hasTouchTransmitter(coin) then
		return false
	end

	local claimedAt = claimedCoins[coin]
	if claimedAt and os.clock() - claimedAt < REVISIT_DELAY then
		return false
	end

	return true
end

local function getNearestCoin()
	if not hrp or not hrp.Parent then
		return nil
	end

	for coin in pairs(claimedCoins) do
		if not coin.Parent then
			claimedCoins[coin] = nil
		end
	end

	local nearest
	local nearestDistance = MAX_DISTANCE

	for _, container in ipairs(getCoinContainers()) do
		for _, obj in ipairs(container:GetDescendants()) do
			if canSelectCoin(obj) then
				local distance = (hrp.Position - obj.Position).Magnitude
				if distance <= nearestDistance then
					nearestDistance = distance
					nearest = obj
				end
			end
		end
	end

	return nearest
end

local function getTargetCFrame(coin)
	-- Put the head on the coin while the lower body stays below it.
	return CFrame.new(coin.Position - HEAD_TO_COIN_OFFSET)
end

local function getCoinContainer(coin)
	local parent = coin and coin.Parent

	while parent and parent ~= workspace do
		if parent.Name == "CoinContainer" then
			return parent
		end

		parent = parent.Parent
	end

	return nil
end

local function jiggleIntoCoin(coin)
	if not coin or not coin.Parent or not hrp or not hrp.Parent then
		return
	end

	local basePosition = coin.Position - HEAD_TO_COIN_OFFSET
	local oldAutoRotate = humanoid and humanoid.AutoRotate

	if humanoid and humanoid.Parent then
		humanoid.AutoRotate = false
	end

	for _, offset in ipairs(COIN_NUDGE_OFFSETS) do
		if not coin.Parent
			or not hrp.Parent
			or not hasTouchTransmitter(coin)
			or isCoinBagFull() then
			break
		end

		hrp.CFrame = CFrame.new(basePosition + offset)
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		RunService.Heartbeat:Wait()
		task.wait(COIN_NUDGE_DELAY)
	end

	if humanoid and humanoid.Parent then
		humanoid.AutoRotate = oldAutoRotate
	end
end

local function tweenToCoin(coin)
	if not coin or not coin.Parent or not hrp or not hrp.Parent then
		return false
	end

	if isCoinBagFull() then
		return false
	end

	local container = getCoinContainer(coin)
	local targetCFrame = getTargetCFrame(coin)
	local distance = (hrp.Position - targetCFrame.Position).Magnitude

	if distance > MAX_DISTANCE then
		return false
	end

	if currentTween then
		currentTween:Cancel()
	end

	local oldAutoRotate = humanoid.AutoRotate
	humanoid.AutoRotate = false

	local duration = math.max(distance / getSpeed(), MIN_TWEEN_TIME)
	local tween = TweenService:Create(
		hrp,
		TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
		{
			CFrame = targetCFrame,
		}
	)

	currentTween = tween
	tween:Play()

	local stoppedForFullBag = false

	while tween.PlaybackState == Enum.PlaybackState.Playing do
		if not coin.Parent
			or (container and not container.Parent)
			or not hasTouchTransmitter(coin)
			or not hrp.Parent then
			tween:Cancel()
			break
		end

		if isCoinBagFull() then
			stoppedForFullBag = true
			tween:Cancel()
			break
		end

		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		RunService.Heartbeat:Wait()
	end

	local reached = hrp.Parent
		and not stoppedForFullBag
		and (hrp.Position - targetCFrame.Position).Magnitude <= 5

	if currentTween == tween then
		currentTween = nil
	end

	if humanoid and humanoid.Parent then
		humanoid.AutoRotate = oldAutoRotate
	end

	if reached then
		claimedCoins[coin] = os.clock()
	end

	return reached
end

local function tweenUntilCoinGone(coin)
	local container = getCoinContainer(coin)
	local hadTouchTransmitter = hasTouchTransmitter(coin)

	while coin
		and coin.Parent
		and (not container or container.Parent)
		and hasTouchTransmitter(coin)
		and character
		and hrp
		and hrp.Parent do
		if isCoinBagFull() then
			handleFullCoinBag()
			break
		end

		local reached = tweenToCoin(coin)

		if reached then
			jiggleIntoCoin(coin)
		end

		if isCoinBagFull() then
			handleFullCoinBag()
			break
		end

		if not coin.Parent
			or (container and not container.Parent)
			or not hasTouchTransmitter(coin) then
			break
		end

		task.wait(RETWEEN_DELAY)
	end

	if hadTouchTransmitter
		and coin
		and (not coin.Parent or not hasTouchTransmitter(coin)) then
		task.wait(getWaitAfterTouch())
	end

	claimedCoins[coin] = nil
end

RunService.Stepped:Connect(function()
	if not character or not hrp or not hrp.Parent then
		return
	end

	if isNoclipEnabled() then
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
	end

	local fallHeight = getFallHeight()

	if hrp.Position.Y <= fallHeight then
		if currentTween then
			currentTween:Cancel()
			currentTween = nil
		end

		if lastSafeCFrame then
			hrp.CFrame = lastSafeCFrame
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end
	elseif not currentTween then
		lastSafeCFrame = hrp.CFrame
	end
end)

